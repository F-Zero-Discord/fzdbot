DISCORD_TOKEN=your_discord_bot_token_here
SERVER_ID=id_of_server_where_bot_runs

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=mydbuser
DB_PASSWORD=supersecretpassword
DB_NAME=mydatabase

# FZD API (required). One key per environment, minted by fzd-api's api-key-new
FZD_API_BASE_URL=https://api-stage.fzd.gg
FZD_API_KEY=your_api_key

# Optional settings
LOG_LEVEL=INFO
ERROR_ALERT_CHANNEL_ID=
# {"<scheduled_event_id>": <role_id>}, empty for no event-role sync. Not empty
# needs the members intent granted in the application's portal, or the bot will
# not start, and fzdbot's role above the roles named here, or every add is refused.
GGP8_EVENT_ROLES={}
EVENT_ROLE_SYNC_SECONDS=300
SCOREBOARD_DISPLAY_PODIUM=false
SCOREBOARD_LINES_PER_BLOCK=8
SCOREBOARD_REFRESH_SECONDS=10
DEBUG_SCOREBOARD=False
